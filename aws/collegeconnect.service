[Unit]
Description=CollegeConnect Flask application (Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/CollegeConnect_AWS
EnvironmentFile=/home/ec2-user/CollegeConnect_AWS/.env
ExecStart=/home/ec2-user/CollegeConnect_AWS/.venv/bin/gunicorn --workers 2 --threads 2 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
