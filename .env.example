# Development default: in-memory storage. Deployment: SQL backed by private Amazon RDS MySQL.
STORAGE_BACKEND=memory
FLASK_DEBUG=0
PORT=5000

# Generate unique secrets: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_LONG_UNIQUE_PASSWORD

# When STORAGE_BACKEND=sql, fill RDS connection fields below:
DB_HOST=REPLACE_WITH_RDS_ENDPOINT
DB_PORT=3306
DB_NAME=collegeconnect
DB_USER=collegeapp
DB_PASSWORD=REPLACE_WITH_DB_USER_PASSWORD
DB_SSL_CA=/etc/ssl/certs/rds-global-bundle.pem
DB_REQUIRE_TLS=1

# Use HTTPS with a real domain and TLS certificate before enabling this:
SESSION_COOKIE_SECURE=0
